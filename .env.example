# Create a key at https://console.groq.com/keys
GROQ_API_KEY=

# Optional Groq model overrides.
GROQ_TEXT_MODEL=openai/gpt-oss-120b
GROQ_INTERVIEW_MODEL=openai/gpt-oss-20b
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
GROQ_TTS_VOICE=troy

# Optional canonical deployment origin used for social metadata.
# SITE_URL=https://your-athena-site.example
